# Copy this file to `.env` and fill it in. `.env` is gitignored.
#
# Leave any of these blank and the game still runs — it just stays single-player
# and saves to this browser only. Nothing here is required to play.

# --- Supabase: accounts + cloud saves (Tahap 1 in MULTIPLAYER.md) ---
# Project Settings -> API. The anon key is MEANT to be public; Row Level
# Security is what protects the data. Never put the service_role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- The multiplayer server on your VPS (Tahap 2) ---
# MUST be wss:// in production — a browser refuses a plain ws:// socket from an
# https:// page and there is no way around it.
# Local testing: ws://localhost:8787
VITE_GAME_SERVER=
